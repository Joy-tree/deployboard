# ─ DeployBoard Environment Variables ─────────────────────────────────────
PORT=3001
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?appName=DeployBoard
SITES_DIR=/var/www/user-sites
TMP_DIR=/tmp/deployboard-builds

# GitHub token for private repos (optional)
GITHUB_TOKEN=
# GitHub OAuth app credentials (required for "Continue with GitHub")
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional legacy aliases also supported:
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GH_CLIENT_ID=
# GH_CLIENT_SECRET=
GLOBAL_WEBHOOK_SECRET=change_me_to_a_long_random_value

# AI providers
# Joytree AI v1 uses Groq. Joytree API v4 now uses Groq + xAI/Grok together.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Optional Joytree API v3 provider
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_FALLBACK=deepseek-v4-flash

# Your domain — every deployed app gets subdomain.BASE_DOMAIN
BASE_DOMAIN=example.com

# Cloudflare — set CF_WILDCARD_MODE=true if you have a wildcard A record
CF_WILDCARD_MODE=true
CF_API_TOKEN=
CF_ZONE_ID=
CF_TUNNEL_ID=
CF_ACCOUNT_ID=
