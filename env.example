# ─ DeployBoard Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in real values there. .env is (and must
# stay) gitignored -- never commit real secrets to this file. Every value
# below is a placeholder, not a working credential.
PORT=3001
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/?appName=YourApp
SITES_DIR=/var/www/user-sites
TMP_DIR=/tmp/deployboard-builds

# Your GitHub token for private repos (optional)
GITHUB_TOKEN=ghp_your_github_personal_access_token
# GitHub OAuth app credentials (required for "Continue with GitHub")
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# Optional legacy aliases also supported:
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GH_CLIENT_ID=
# GH_CLIENT_SECRET=
GLOBAL_WEBHOOK_SECRET=change_me_to_a_long_random_value

# Your domain — every deployed app gets subdomain.BASE_DOMAIN
BASE_DOMAIN=yourdomain.com

# Cloudflare — set CF_WILDCARD_MODE=true if you have a wildcard A record
CF_WILDCARD_MODE=true
CF_API_TOKEN=your_cloudflare_api_token
CF_ZONE_ID=your_cloudflare_zone_id
CF_TUNNEL_ID=your_cloudflare_tunnel_id
CF_ACCOUNT_ID=your_cloudflare_account_id

# Firebase Realtime Database (used for workspaces, custom domains, API keys, etc.)
FIREBASE_RTDB_URL=https://your-project.firebaseio.com
FIREBASE_RTDB_SECRET=your_firebase_database_secret

# Dedicated MongoDB instance for deploy push notification subscriptions --
# separate from the main MONGODB_URI above by design.
PUSH_MONGODB_URI=mongodb://user:password@host:port/dbname?authSource=admin
