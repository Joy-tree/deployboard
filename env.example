# ─ DeployBoard Environment Variables ─────────────────────────────────────
PORT=3001
MONGODB_URI=mongodb://localhost:27017/deployboard
SITES_DIR=/var/www/user-sites
TMP_DIR=/tmp/deployboard-builds

# Optional server-level GitHub token for legacy/manual flows.
# OAuth-connected users deploy private repos with their own GitHub access token.
GITHUB_TOKEN=

# GitHub OAuth app credentials (required for "Continue with GitHub")
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional legacy aliases also supported:
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GH_CLIENT_ID=
# GH_CLIENT_SECRET=

# Optional webhook fallback. OAuth polling auto-deploy works without webhooks.
GLOBAL_WEBHOOK_SECRET=change_me_to_a_long_random_value

# OAuth polling pipeline interval for auto-deploy checks. Minimum: 15000.
AUTO_DEPLOY_POLL_INTERVAL_MS=90000
AUTO_DEPLOY_INITIAL_DELAY_MS=12000

# Your domain — every deployed app gets subdomain.BASE_DOMAIN
BASE_DOMAIN=joytreehostingserver.dpdns.org

# Cloudflare — set CF_WILDCARD_MODE=true if you have a wildcard A record
CF_WILDCARD_MODE=true
CF_API_TOKEN=
CF_ZONE_ID=
CF_TUNNEL_ID=
CF_ACCOUNT_ID=
